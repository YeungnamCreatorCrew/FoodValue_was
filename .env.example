# 이 파일을 .env 로 복사해서 값을 채운다. (cp .env.example .env)
# .env 는 커밋하지 않는다. 실제 키 값은 Git이나 메신저에 붙여넣지 말고 .env 파일로 직접 전달한다.

# --- DB (docker-compose.yml 과 앱이 함께 읽는다) ---
DB_NAME=foodvalue
DB_USER=foodvalue
DB_PASSWORD=change-me
DB_PORT=5432
# SQLAlchemy + psycopg 3 형식. 운영(Supabase)은 이 값만 바꾼다.
DATABASE_URL=postgresql+psycopg://foodvalue:change-me@localhost:5432/foodvalue

# --- 인증 ---
# 32자 이상 무작위 문자열. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more

# --- 이미지 저장소 (S3 API) ---
# 로컬은 Docker MinIO, 운영은 Supabase Storage 의 S3 연결 정보로 값만 바꾼다.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=foodvalue
# 로컬 MinIO 루트 계정을 겸한다. 비밀번호는 8자 이상.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8
# 업로드한 파일을 읽는 공개 주소. 로컬은 http://localhost:9000/<버킷>
S3_PUBLIC_BASE_URL=http://localhost:9000/foodvalue

# --- Gemini (레시피 생성) ---
# 둘 다 없으면 레시피 생성 요청 시점에 오류가 난다. 모델명은 사용할 Gemini 모델 ID로 채운다.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- CLOVA 영수증 OCR (냉장고). 미설정 시 업로드 API만 503, 직접 등록은 이용 가능 ---
CLOVA_OCR_RECEIPT_URL=
CLOVA_OCR_SECRET=

# --- 선택 ---
# 웹 프론트가 다른 origin 에서 호출할 때 허용할 주소(쉼표 구분). 비우면 localhost:3000, localhost:5173 만 허용한다.
# 운영 배포 시에는 반드시 프론트 도메인을 지정한다.
# CORS_ORIGINS=https://example.com
